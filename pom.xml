<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.valkeyry</groupId>
    <artifactId>valkeyry-ecosystem-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Valkeyry Ecosystem (Reactor Parent)</name>
    <description>Multi-module reactor for valkeyry-ipaas, valkeyry-config and valkeyry-config-plugin.</description>

    <!--
        We intentionally do NOT inherit from spring-boot-starter-parent at the reactor level,
        because the build-tool plugin sub-modules must NOT pull in Spring Boot's plugin
        management defaults (which would conflict with maven-plugin / gradle-api packaging).
        Each Spring Boot module declares its own <parent>spring-boot-starter-parent</parent>.
    -->

    <modules>
        <!-- Order matters: plugin-core is a test-scope dependency of valkeyry-config. -->
        <module>valkeyry-config-plugin</module>
        <module>valkeyry-ipaas</module>
        <module>valkeyry-config</module>
        <module>valkeyry-ipaas-demo-client</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>3.3.5</spring-boot.version>
        <reactor-rabbitmq.version>1.5.6</reactor-rabbitmq.version>
        <reactor-kafka.version>1.3.23</reactor-kafka.version>
        <aws-sdk.version>2.28.11</aws-sdk.version>
        <azure-storage.version>12.28.1</azure-storage.version>
        <testcontainers.version>1.20.3</testcontainers.version>
        <mock-oauth2-server.version>2.1.10</mock-oauth2-server.version>
        <json-schema-validator.version>1.5.3</json-schema-validator.version>
        <maven-plugin-api.version>3.9.9</maven-plugin-api.version>
        <maven-plugin-annotations.version>3.13.1</maven-plugin-annotations.version>
        <gradle-api.version>8.10</gradle-api.version>
        <opentelemetry.version>1.42.1</opentelemetry.version>
        <jakarta-json.version>2.0.1</jakarta-json.version>
    </properties>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>21</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
